# Copy to .env (bin/setup does this). .env is gitignored.
# Get a key at https://console.anthropic.com/  (without one, the app still works: no AI features)
ANTHROPIC_API_KEY=
# Optional: model for the agent (default claude-opus-5-5)
CLAUDE_MODEL=
# Optional: keep your private data somewhere other than ./data
NB_DATA_DIR=
